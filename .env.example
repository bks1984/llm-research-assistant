# Copy to .env and fill in ONE provider key. Never commit .env.

# --- Groq (free tier available: https://console.groq.com/keys)
GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b

# --- OpenAI (also needed if you choose OpenAI embeddings)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=          # e.g. an OpenAI-compatible proxy

# --- Optional overrides
# LLM_PROVIDER=Groq          # Groq | OpenAI (default: whichever key is set)
# JUDGE_MODEL=               # model used for LLM-as-a-judge (default: same as chat model)
# REASONING_EFFORT=none      # for reasoning models on Groq (e.g. qwen3), hides thinking
# CHUNK_SIZE=512
# CHUNK_OVERLAP=64
# TOP_K=5
# TEMPERATURE=0.3
# MAX_TOKENS=700
